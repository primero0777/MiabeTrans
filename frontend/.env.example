# Copier en .env.production pour le build GitHub Pages
# (ces valeurs ne sont pas secrètes : elles finissent dans le JavaScript public)

# Adresse de l'API PHP sur Render (sans / final)
VITE_API_URL=https://miabetrans-api.onrender.com/backend/api

# Sous-dossier GitHub Pages : /<nom-du-dépôt>/  (laisser / pour un domaine personnalisé)
VITE_BASE=/miabetrans/
