# Copier ce fichier en .env et remplir les valeurs réelles (développement local)
# cp .env.example .env
# En ligne (Render), ces mêmes variables se saisissent dans Environment.

# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
# Adresse du site React (utilisée dans les liens des emails)
FRONTEND_URL=http://localhost:5173
# Origines autorisées à appeler l'API (séparées par des virgules, sans chemin)
CORS_ORIGINS=http://localhost:5173

# ─── Base de données MySQL ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=miabetrans_db
DB_USER=root
DB_PASS=
# Contenu du certificat ca.pem (Aiven) — laisser vide en local
DB_SSL_CA=

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Chaîne aléatoire d'au moins 64 caractères (obligatoire en production)
JWT_SECRET=change_me_with_a_long_random_string
JWT_EXPIRATION=86400

# ─── Emails ──────────────────────────────────────────────────────────────────
MAIL_FROM=ton.adresse@gmail.com
MAIL_FROM_NAME=MiabeTrans
# En ligne : clé API Brevo (prioritaire sur le SMTP)
BREVO_API_KEY=
# En local : SMTP Gmail avec un mot de passe d'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── Divers ──────────────────────────────────────────────────────────────────
WHATSAPP_NUM=22890000001
